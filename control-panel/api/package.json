{
    "name": "register-service-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "build": "nest build",
        "build:cli": "node -r ts-node/register -r tsconfig-paths/register ./scripts/build-cli.ts",
        "cli": "sh -c 'if [ \"${NODE_ENV:-}\" = \"production\" ] || [ ! -f ./scripts/cli.ts ]; then node dist/scripts/cli.js \"$@\"; else node -r ts-node/register -r tsconfig-paths/register ./scripts/cli.ts \"$@\"; fi' --",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
        "start": "nest start",
        "start:dev": "NODE_ENV=development nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "NODE_ENV=production node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.{ts,tsx}\" --fix",
        "test": "npm run test:unit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-unit.json"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.2.3",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.8",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "cookie-parser": "^1.4.7",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^5.10.1",
        "nodemailer": "^9.0.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "pino": "^10.3.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.10.7",
        "@types/nodemailer": "^8.0.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/supertest": "^6.0.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "madge": "^8.0.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts",
            "tsx"
        ],
        "rootDir": ".",
        "testMatch": [
            "<rootDir>/test/unit/**/*.spec.ts"
        ],
        "transform": {
            "^.+\\.(t|j)sx?$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "collectCoverageFrom": [
            "src/**/*.(t|j)sx?"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node"
    }
}
