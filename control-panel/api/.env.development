# Variables for development mode; this file is committed to Git. For production, create a .env file with the corresponding variables.
COOKIE_DOMAIN=localhost
NODE_ENV=development
LOG_STRUCTURED_BOOTSTRAP_ENABLED=false

DB_USER=admin
DB_PASSWORD=admin_pass
DB_NAME=pampilo_db
DB_PORT=5432
DB_HOST=localhost

REDIS_PORT=6379

# Object storage
# Use provider=s3 with MinIO at http://localhost:9001.
# Use provider=gcs with local GCS emulator at http://localhost:4443.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9001
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9001
LOCAL_GCS_ENDPOINT=http://localhost:4443
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=pampilo-local
OBJECT_STORAGE_ACCESS_KEY=pampilo_minio
OBJECT_STORAGE_SECRET_KEY=pampilo_minio_dev_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true

JWT_SECRET=8f3d9c2e-7a4b-4f1e-9b2d-6a3c5f7d9e0b!QwErTyUiOpAsDfGhJkLzXcVbNm1234
JWT_ACCESS_TOKEN_TTL=5m
JWT_REFRESH_TOKEN_TTL=7d
SESSION_MAX_TTL=7d
DEVICE_ID_COOKIE_TTL=365d

ENCRYPTION_KEY=SpklRwLBXDiNNpjglsTg5PAqGDS19LxNHg5jCC+oXUo=

CLIENT_PUBLIC_URL=https://localhost
MAIL_SETTINGS_ENCRYPTION_KEY=SpklRwLBXDiNNpjglsTg5PAqGDS19LxNHg5jCC+oXUo=

# BullMQ Outbound Throttling & Provider Quota Limits
# Capacity target: up to 100 critical email requests/sec and up to 6,000 emails/minute
MAIL_QUEUE_LIMITER_MAX=100
MAIL_QUEUE_LIMITER_DURATION=1000
MAIL_WORKER_CONCURRENCY=4
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_BACKOFF_DELAY=2000
MAIL_RETRY_BACKOFF_TYPE=exponential
MAIL_RETRY_BACKOFF_JITTER=0.2

# Rollout gates
DEVICE_ID_FORWARDING_ENABLED=true
REFRESH_ROTATION_ENABLED=true
DEVICE_BINDING_REQUIRED_CUSTOMER=true
DEVICE_BINDING_REQUIRED_ADMIN=true
LOGIN_CHECKPOINT_ENABLED=true
REAUTH_ENFORCEMENT_ENABLED=true
