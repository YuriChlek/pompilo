{
  "name": "register-service-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "lint:responsive:max-width": "bash -lc 'if rg -n \"@media \\\\(max-width:\" src/components src/features; then echo \"Remove max-width media queries from component CSS.\"; exit 1; fi'",
    "lint:responsive:breakpoints": "bash -lc 'if rg -n --pcre2 \"@media \\\\(min-width: (?!768px|1024px|1280px|1536px)\" src/components src/features; then echo \"Use only canonical min-width breakpoints: 768, 1024, 1280, 1536.\"; exit 1; fi'",
    "lint:responsive": "npm run lint:responsive:max-width && npm run lint:responsive:breakpoints",
    "lint:cycles": "madge --circular --extensions ts,tsx src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^9.1.1",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "next": "^16.1.6",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
